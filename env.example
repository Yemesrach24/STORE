# ========================================
# INVENTORY MANAGEMENT SYSTEM
# Environment Variables Configuration
# ========================================

# ========================================
# GOOGLE OAUTH 2.0 AUTHENTICATION (Auth.js / NextAuth)
# ========================================

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Google OAuth credentials. Create an OAuth 2.0 Client ID at:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# Base URL of the app (used by Auth.js)
AUTH_URL=http://localhost:3000
# AUTH_URL=https://your-domain.com

# ========================================
# DATABASE CONFIGURATION
# ========================================

# Development - Local MongoDB
MONGODB_URI=mongodb://localhost:27017/inventory-management

# Development - MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inventory-management?retryWrites=true&w=majority

# Production - MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@production-cluster.mongodb.net/inventory-management?retryWrites=true&w=majority

# ========================================
# RATE LIMITING CONFIGURATION
# ========================================

# Rate limiting settings (optional - defaults will be used if not set)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Admin endpoints rate limiting
ADMIN_RATE_LIMIT_MAX=50
ADMIN_RATE_LIMIT_WINDOW_MS=60000

# Authentication endpoints rate limiting
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ========================================
# APPLICATION CONFIGURATION
# ========================================

# Environment
NODE_ENV=development
# NODE_ENV=production

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ========================================
# SECURITY CONFIGURATION
# ========================================

# JWT Secret (if using custom JWT)
JWT_SECRET=your_jwt_secret_key_here

# Session Secret
SESSION_SECRET=your_session_secret_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# CORS_ORIGIN=https://your-domain.com

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================

# Maximum file size (in bytes) - 5MB default
MAX_FILE_SIZE=5242880

# Allowed file types for uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# File upload directory
UPLOAD_DIR=./uploads

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================

# SMTP Configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@your-domain.com

# ========================================
# LOGGING CONFIGURATION
# ========================================

# Log level
LOG_LEVEL=info
# LOG_LEVEL=debug
# LOG_LEVEL=warn
# LOG_LEVEL=error

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Enable error logging
ENABLE_ERROR_LOGGING=true

# ========================================
# MONITORING & ANALYTICS
# ========================================

# Sentry DSN (for error tracking)
SENTRY_DSN=your_sentry_dsn_here

# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ========================================
# FEATURE FLAGS
# ========================================

# Enable/disable features
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_AUDIT_LOGS=true
ENABLE_BACKUP_AUTOMATION=false

# ========================================
# DEVELOPMENT TOOLS
# ========================================

# Enable development tools
ENABLE_DEV_TOOLS=true
ENABLE_API_DOCS=true
ENABLE_SEED_DATA=true

# ========================================
# TESTING CONFIGURATION
# ========================================

# Test database URI
TEST_MONGODB_URI=mongodb://localhost:27017/inventory-management-test

# Test environment
NODE_ENV=test

# ========================================
# DEPLOYMENT CONFIGURATION
# ========================================

# Build configuration
NEXT_TELEMETRY_DISABLED=1

# Performance monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false

# ========================================
# WEBHOOK CONFIGURATION
# ========================================

# (Clerk webhooks removed — users are synced to MongoDB during OAuth sign-in)

# Webhook timeout (in milliseconds)
WEBHOOK_TIMEOUT=10000

# ========================================
# CACHE CONFIGURATION
# ========================================

# Redis configuration (if using Redis for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Cache TTL (in seconds)
CACHE_TTL=3600

# ========================================
# BACKUP CONFIGURATION
# ========================================

# Backup schedule (cron expression)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (in days)
BACKUP_RETENTION_DAYS=30

# Backup storage location
BACKUP_STORAGE_PATH=./backups

# ========================================
# SETUP INSTRUCTIONS
# ========================================

# 1. Copy this file to .env.local
# 2. Update the values with your actual configuration
# 3. For production, create .env.production with production values
# 4. Never commit .env.local or .env.production to version control

# ========================================
# GOOGLE OAUTH SETUP INSTRUCTIONS
# ========================================

# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google
#    - https://your-domain.com/api/auth/callback/google
# 4. Copy the Client ID to AUTH_GOOGLE_ID and the Client Secret to AUTH_GOOGLE_SECRET
# 5. Set AUTH_SECRET (openssl rand -base64 32)
# 6. On first sign-in, the user is created in MongoDB automatically with role "user"
#    (promote yourself to "admin" in the database or via the admin panel)

# ========================================
# MONGODB SETUP INSTRUCTIONS
# ========================================

# Local MongoDB:
# 1. Install MongoDB locally
# 2. Start MongoDB service
# 3. Create database: inventory-management

# MongoDB Atlas:
# 1. Create MongoDB Atlas account
# 2. Create a new cluster
# 3. Create database user with read/write permissions
# 4. Get connection string from cluster
# 5. Update MONGODB_URI with your connection string

# ========================================
# RATE LIMITING SETUP
# ========================================

# The application includes built-in rate limiting:
# - Authentication endpoints: 5 requests/minute
# - Admin endpoints: 50 requests/minute  
# - Regular endpoints: 100 requests/minute

# You can customize these limits by setting the environment variables above.

# ========================================
# SECURITY NOTES
# ========================================

# 1. Use strong, unique passwords for all services
# 2. Enable 2FA on all accounts
# 3. Use environment-specific keys (dev/staging/prod)
# 4. Regularly rotate secrets and keys
# 5. Monitor logs for suspicious activity
# 6. Keep dependencies updated
# 7. Use HTTPS in production
# 8. Implement proper CORS policies 