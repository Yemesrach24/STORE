{
  "info": {
    "name": "Inventory Management API",
    "description": "Complete API collection for the Next.js 14 Inventory Management System",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/me"
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "Update User Settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+1234567890\",\n  \"location\": \"New York, NY\",\n  \"bio\": \"Inventory manager\",\n  \"timezone\": \"America/New_York\",\n  \"language\": \"en\",\n  \"currency\": \"USD\",\n  \"dateFormat\": \"MM/DD/YYYY\",\n  \"emailNotifications\": true,\n  \"lowStockAlerts\": true,\n  \"weeklyReports\": false,\n  \"marketingEmails\": false,\n  \"theme\": \"system\",\n  \"autoLogout\": true,\n  \"twoFactorAuth\": false\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/settings"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Electronic devices and accessories\",\n  \"color\": \"#3B82F6\",\n  \"icon\": \"laptop\",\n  \"parentId\": null\n}"
            },
            "url": "{{baseUrl}}/api/categories"
          }
        }
      ]
    },
    {
      "name": "Inventory Items",
      "item": [
        {
          "name": "Get Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "category",
                  "value": ""
                },
                {
                  "key": "stockStatus",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"High-performance laptop\",\n  \"quantity\": 10,\n  \"price\": 999.99,\n  \"categoryId\": \"{{categoryId}}\",\n  \"sku\": \"LAP001\",\n  \"barcode\": \"1234567890123\",\n  \"unit\": \"piece\",\n  \"minQuantity\": 2,\n  \"maxQuantity\": 50,\n  \"location\": \"Warehouse A\",\n  \"supplier\": \"Tech Supplies Inc\",\n  \"costPrice\": 800.00,\n  \"tags\": [\"electronics\", \"computer\"]\n}"
            },
            "url": "{{baseUrl}}/api/items"
          }
        },
        {
          "name": "Get Item by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{itemId}}"
          }
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Laptop\",\n  \"description\": \"Updated description\",\n  \"quantity\": 15,\n  \"price\": 1099.99,\n  \"categoryId\": \"{{categoryId}}\",\n  \"sku\": \"LAP001-UPD\",\n  \"barcode\": \"1234567890124\",\n  \"unit\": \"piece\",\n  \"minQuantity\": 3,\n  \"maxQuantity\": 60,\n  \"location\": \"Warehouse B\",\n  \"supplier\": \"Updated Tech Supplies\",\n  \"costPrice\": 900.00,\n  \"tags\": [\"electronics\", \"computer\", \"updated\"]\n}"
            },
            "url": "{{baseUrl}}/api/items/{{itemId}}"
          }
        },
        {
          "name": "Update Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 20,\n  \"type\": \"ADJUSTMENT\",\n  \"reason\": \"Stock adjustment\",\n  \"notes\": \"Manual inventory correction\"\n}"
            },
            "url": "{{baseUrl}}/api/items/{{itemId}}"
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{itemId}}"
          }
        },
        {
          "name": "Export Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/export",
              "query": [
                {
                  "key": "format",
                  "value": "csv"
                },
                {
                  "key": "category",
                  "value": ""
                },
                {
                  "key": "stockStatus",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
